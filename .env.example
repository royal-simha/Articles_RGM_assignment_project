PORT=5000
NODE_ENV=development

# Database configuration:
# 1. SQLite (Default for zero-setup local dev & tests):
DATABASE_URL="file:./dev.db"

# 2. PostgreSQL (Production / Cloud / Local Postgres):
# DATABASE_URL="postgresql://username:password@localhost:5432/blog_management_db?schema=public"

JWT_SECRET=super-secret-jwt-key-for-blog-management-system-2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
